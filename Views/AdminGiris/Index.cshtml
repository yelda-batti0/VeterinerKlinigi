@model VeterinerKlinigi.Models.AdminGirisViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yönetici Girişi - VetKlinik</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                min-height: 100vh;
                margin: 0;
                background: #f1f6f9;
            }

            .login-wrap {
                min-height: 100vh;
                display: flex;
            }

            .login-side {
                flex: 1;
                color: #fff;
                padding: 56px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                background: linear-gradient(150deg, #0f766e 0%, #0e7490 55%, #075985 100%);
                position: relative;
                overflow: hidden;
            }

                .login-side::after {
                    content: "";
                    position: absolute;
                    width: 420px;
                    height: 420px;
                    border-radius: 50%;
                    background: rgba(255,255,255,.07);
                    right: -120px;
                    bottom: -120px;
                }

            .brand {
                display: flex;
                align-items: center;
                gap: 12px;
                font-weight: 800;
                font-size: 22px;
            }

            .brand-icon {
                width: 48px;
                height: 48px;
                border-radius: 14px;
                background: rgba(255,255,255,.18);
                display: grid;
                place-items: center;
                font-size: 24px;
            }

            .login-side h1 {
                font-size: 40px;
                font-weight: 800;
                line-height: 1.15;
                max-width: 460px;
            }

            .login-side p {
                opacity: .85;
                max-width: 440px;
                font-size: 16px;
            }

            .feature {
                display: flex;
                gap: 10px;
                align-items: center;
                opacity: .9;
                margin-bottom: 10px;
            }

            .login-form-side {
                width: 520px;
                max-width: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px;
                background: #fff;
            }

            .login-box {
                width: 100%;
                max-width: 380px;
            }

                .login-box h2 {
                    font-weight: 800;
                    font-size: 28px;
                }

            .form-control {
                border-radius: 12px;
                padding: .75rem 1rem;
                border-color: #e2e8f0;
            }

                .form-control:focus {
                    border-color: #0d9488;
                    box-shadow: 0 0 0 .2rem rgba(13,148,136,.15);
                }

            .input-icon {
                position: relative;
            }

                .input-icon i {
                    position: absolute;
                    left: 14px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #94a3b8;
                }

                .input-icon .form-control {
                    padding-left: 42px;
                }

            .btn-brand {
                background: linear-gradient(135deg, #0d9488, #0284c7);
                color: #fff;
                border: none;
                border-radius: 12px;
                padding: .8rem;
                font-weight: 700;
            }

                .btn-brand:hover {
                    color: #fff;
                    box-shadow: 0 10px 24px rgba(13,148,136,.3);
                }

            .form-check-input:checked {
                background-color: #0d9488;
                border-color: #0d9488;
            }

            @@media (max-width: 991px) {
                .login-side {
                    display: none;
                }

                .login-form-side {
                    width: 100%;
                }
            }
    </style>
</head>
<body>
    <div class="login-wrap">
        <div class="login-side">
            <div class="brand"><div class="brand-icon"><i class="bi bi-heart-pulse-fill"></i></div> VetKlinik</div>
            <div>
                <h1>Kliniklerinizi tek panelden yönetin.</h1>
                <p>Klinikler, hizmetler, veteriner hekimler ve randevular tek bir yerde.</p>
                <div class="mt-4">
                    <div class="feature"><i class="bi bi-check2-circle"></i> Çoklu klinik ve hizmet yönetimi</div>
                    <div class="feature"><i class="bi bi-check2-circle"></i> Hekim müsaitlik takibi</div>
                    <div class="feature"><i class="bi bi-check2-circle"></i> Randevu onay sistemi</div>
                </div>
            </div>
            <small class="opacity-75">© @DateTime.Now.Year VetKlinik Yönetim Paneli</small>
        </div>

        <div class="login-form-side">
            <div class="login-box">
                <h2>Yönetici Girişi</h2>
                <p class="text-muted mb-4">Devam etmek için yönetici hesabınızla giriş yapın.</p>

                <form asp-action="Index" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
                    }

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <div class="input-icon">
                            <i class="bi bi-envelope"></i>
                            <input asp-for="Email" class="form-control" placeholder="ornek@sakarya.edu.tr" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Sifre" class="form-label fw-semibold"></label>
                        <div class="input-icon">
                            <i class="bi bi-lock"></i>
                            <input asp-for="Sifre" class="form-control" placeholder="••••••" />
                        </div>
                        <span asp-validation-for="Sifre" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="BeniHatirla" class="form-check-input" />
                        <label asp-for="BeniHatirla" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-brand w-100">Giriş Yap <i class="bi bi-arrow-right ms-1"></i></button>
                </form>

                <div class="text-center mt-4">
                    <a asp-controller="Home" asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left"></i> Siteye dön</a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>