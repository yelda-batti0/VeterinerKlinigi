@using Microsoft.AspNetCore.Identity
@using VeterinerKlinigi.Entities
@inject UserManager<ApplicationUser> UserManager
@{
    Layout = null;
    var aktif = ViewContext.RouteData.Values["controller"]?.ToString();
    var kullanici = await UserManager.GetUserAsync(User);
    var adSoyad = kullanici != null ? $"{kullanici.Ad} {kullanici.Soyad}" : "Yönetici";
    var basHarf = !string.IsNullOrEmpty(kullanici?.Ad) ? kullanici.Ad.Substring(0, 1).ToUpper() : "A";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VetKlinik Yönetim Paneli</title>

    <!-- Bootstrap 5 + Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
            /* ========== DEĞİŞKENLER ========== */
            :root {
                --brand: #0d9488;
                --brand-dark: #0f766e;
                --brand-2: #0284c7;
                --brand-light: #ccfbf1;
                --bg: #f1f6f9;
                --text: #0f172a;
                --muted: #64748b;
                --border: #e2e8f0;
                --sidebar-w: 260px;
                --sidebar-w-mini: 80px;
                --radius: 16px;
                --shadow: 0 1px 2px rgba(15,23,42,.04), 0 8px 24px rgba(15,23,42,.06);
            }

            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                background: var(--bg);
                color: var(--text);
                margin: 0;
            }

            /* ========== SIDEBAR ========== */
            .sidebar {
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                width: var(--sidebar-w);
                z-index: 1040;
                background: linear-gradient(180deg, #0f766e 0%, #0e7490 55%, #075985 100%);
                color: #fff;
                display: flex;
                flex-direction: column;
                padding: 20px 14px;
                overflow-y: auto;
                transition: width .25s ease, transform .25s ease;
            }

            .sidebar-brand {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 6px 8px 22px;
                color: #fff;
                text-decoration: none;
            }

            .brand-icon {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: rgba(255,255,255,.18);
                display: grid;
                place-items: center;
                font-size: 22px;
                flex-shrink: 0;
            }

            .brand-text {
                display: flex;
                flex-direction: column;
                line-height: 1.15;
            }

                .brand-text span {
                    font-weight: 800;
                    font-size: 18px;
                }

                .brand-text small {
                    opacity: .75;
                    font-size: 12px;
                }

            .sidebar-section {
                font-size: 11px;
                letter-spacing: .08em;
                text-transform: uppercase;
                opacity: .6;
                padding: 16px 12px 6px;
                white-space: nowrap;
            }

            .sidebar .nav-link {
                display: flex;
                align-items: center;
                gap: 12px;
                color: rgba(255,255,255,.82);
                padding: 11px 12px;
                border-radius: 12px;
                font-weight: 500;
                font-size: 14.5px;
                white-space: nowrap;
                transition: background .15s, color .15s;
            }

                .sidebar .nav-link i {
                    font-size: 18px;
                    width: 22px;
                    text-align: center;
                    flex-shrink: 0;
                }

                .sidebar .nav-link:hover {
                    background: rgba(255,255,255,.12);
                    color: #fff;
                }

                .sidebar .nav-link.active {
                    background: #fff;
                    color: var(--brand-dark);
                    font-weight: 700;
                    box-shadow: 0 6px 16px rgba(0,0,0,.12);
                }

            .sidebar-footer {
                margin-top: auto;
                padding-top: 16px;
                border-top: 1px solid rgba(255,255,255,.15);
            }

            .sidebar-backdrop {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(15,23,42,.4);
                z-index: 1035;
            }

            /* Daraltılmış sidebar */
            body.sidebar-mini .sidebar {
                width: var(--sidebar-w-mini);
            }

            body.sidebar-mini .main {
                margin-left: var(--sidebar-w-mini);
            }

            body.sidebar-mini .brand-text,
            body.sidebar-mini .sidebar-section,
            body.sidebar-mini .nav-text {
                display: none;
            }

            body.sidebar-mini .sidebar .nav-link {
                justify-content: center;
            }

            /* ========== ANA ALAN ========== */
            .main {
                margin-left: var(--sidebar-w);
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                transition: margin-left .25s ease;
            }

            .topbar {
                position: sticky;
                top: 0;
                z-index: 1030;
                display: flex;
                align-items: center;
                gap: 16px;
                background: rgba(255,255,255,.88);
                backdrop-filter: blur(10px);
                border-bottom: 1px solid var(--border);
                padding: 14px 28px;
            }

            .icon-btn {
                width: 42px;
                height: 42px;
                border-radius: 12px;
                border: 1px solid var(--border);
                background: #fff;
                display: grid;
                place-items: center;
                font-size: 20px;
                color: var(--text);
            }

                .icon-btn:hover {
                    background: var(--brand-light);
                    color: var(--brand-dark);
                    border-color: transparent;
                }

            .topbar-title h1 {
                font-size: 19px;
                font-weight: 700;
                margin: 0;
            }

            .topbar-title small {
                color: var(--muted);
                font-size: 13px;
            }

            .topbar-right {
                margin-left: auto;
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .date-pill {
                background: #fff;
                border: 1px solid var(--border);
                border-radius: 999px;
                padding: 8px 14px;
                font-size: 13px;
                color: var(--muted);
            }

            .user-btn {
                display: flex;
                align-items: center;
                gap: 10px;
                background: #fff;
                border: 1px solid var(--border);
                border-radius: 999px;
                padding: 5px 14px 5px 5px;
            }

                .user-btn .name {
                    font-weight: 600;
                    font-size: 14px;
                    line-height: 1.1;
                    text-align: left;
                }

                .user-btn .role {
                    font-size: 12px;
                    color: var(--muted);
                }

            .content {
                padding: 28px;
                flex: 1;
            }

            .admin-footer {
                padding: 16px 28px;
                color: var(--muted);
                font-size: 13px;
            }

            /* ========== ORTAK BİLEŞENLER (tüm admin sayfalarında kullanılacak) ========== */
            .avatar {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--brand), var(--brand-2));
                color: #fff;
                display: grid;
                place-items: center;
                font-weight: 700;
                font-size: 14px;
                flex-shrink: 0;
            }

            .avatar-lg {
                width: 56px;
                height: 56px;
                font-size: 20px;
                border-radius: 16px;
            }

            .page-head {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                margin-bottom: 24px;
            }

                .page-head h2 {
                    font-size: 24px;
                    font-weight: 800;
                    margin: 0;
                }

                .page-head p {
                    color: var(--muted);
                    margin: 4px 0 0;
                }

            .card-modern {
                background: #fff;
                border: 1px solid var(--border);
                border-radius: var(--radius);
                box-shadow: var(--shadow);
            }

            .card-modern-header {
                padding: 18px 22px;
                border-bottom: 1px solid var(--border);
                font-weight: 700;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
            }

            .card-modern-body {
                padding: 22px;
            }

            .btn-brand {
                background: linear-gradient(135deg, var(--brand), var(--brand-2));
                color: #fff;
                border: none;
                border-radius: 12px;
                padding: 10px 18px;
                font-weight: 600;
            }

                .btn-brand:hover {
                    color: #fff;
                    filter: brightness(1.05);
                    box-shadow: 0 8px 20px rgba(13,148,136,.3);
                }

            .btn-soft {
                border-radius: 12px;
                border: 1px solid var(--border);
                background: #fff;
                font-weight: 500;
                padding: 10px 18px;
            }

                .btn-soft:hover {
                    background: #f8fafc;
                }

            .btn-icon {
                width: 36px;
                height: 36px;
                border-radius: 10px;
                display: inline-grid;
                place-items: center;
                border: none;
                text-decoration: none;
            }

                .btn-icon.edit {
                    background: #fef3c7;
                    color: #b45309;
                }

                .btn-icon.delete {
                    background: #fee2e2;
                    color: #b91c1c;
                }

                .btn-icon.info {
                    background: #e0f2fe;
                    color: #0369a1;
                }

                .btn-icon:hover {
                    filter: brightness(.94);
                }

            .chip {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 4px 10px;
                border-radius: 999px;
                font-size: 12.5px;
                font-weight: 600;
                background: var(--brand-light);
                color: var(--brand-dark);
            }

                .chip.blue {
                    background: #e0f2fe;
                    color: #0369a1;
                }

                .chip.gray {
                    background: #f1f5f9;
                    color: #475569;
                }

                .chip.warn {
                    background: #fef3c7;
                    color: #92400e;
                }

                .chip.danger {
                    background: #fee2e2;
                    color: #b91c1c;
                }

            .search-box {
                position: relative;
                min-width: 260px;
            }

                .search-box i {
                    position: absolute;
                    left: 14px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: var(--muted);
                }

                .search-box input {
                    padding-left: 40px;
                    height: 44px;
                }

            .form-control, .form-select {
                border-radius: 10px;
                border-color: var(--border);
                padding: .6rem .85rem;
            }

                .form-control:focus, .form-select:focus {
                    border-color: var(--brand);
                    box-shadow: 0 0 0 .2rem rgba(13,148,136,.15);
                }

            .form-check-input:checked {
                background-color: var(--brand);
                border-color: var(--brand);
            }

            .form-label {
                font-weight: 600;
                font-size: 14px;
            }

            .entity-card {
                background: #fff;
                border: 1px solid var(--border);
                border-radius: var(--radius);
                box-shadow: var(--shadow);
                height: 100%;
                display: flex;
                flex-direction: column;
                transition: transform .2s, box-shadow .2s;
            }

                .entity-card:hover {
                    transform: translateY(-4px);
                    box-shadow: 0 16px 32px rgba(15,23,42,.10);
                }

                .entity-card .ec-head {
                    padding: 20px;
                    display: flex;
                    gap: 14px;
                    align-items: center;
                }

                .entity-card .ec-body {
                    padding: 0 20px 16px;
                    flex: 1;
                }

                .entity-card .ec-foot {
                    padding: 14px 20px;
                    border-top: 1px solid var(--border);
                    display: flex;
                    justify-content: flex-end;
                    gap: 8px;
                }

            .empty-state {
                text-align: center;
                padding: 60px 20px;
                color: var(--muted);
            }

                .empty-state i {
                    font-size: 48px;
                    color: var(--brand);
                    opacity: .5;
                }

            .alert-float {
                position: fixed;
                top: 84px;
                right: 24px;
                z-index: 1060;
                min-width: 320px;
                border-radius: 12px;
                box-shadow: 0 12px 30px rgba(15,23,42,.15);
                border: none;
            }

            /* ========== MOBİL ========== */
            @@media (max-width: 991px) {
                .sidebar {
                    transform: translateX(-100%);
                }

                .main {
                    margin-left: 0 !important;
                }

                body.sidebar-open .sidebar {
                    transform: none;
                }

                body.sidebar-open .sidebar-backdrop {
                    display: block;
                }

                .date-pill, .user-btn .name, .user-btn .role {
                    display: none;
                }

                .content {
                    padding: 18px;
                }
            }
    </style>
</head>
<body>
    <!-- ========== SIDEBAR ========== -->
    <aside class="sidebar">
        <a asp-controller="Dashboard" asp-action="Index" class="sidebar-brand">
            <div class="brand-icon"><i class="bi bi-heart-pulse-fill"></i></div>
            <div class="brand-text"><span>VetKlinik</span><small>Yönetim Paneli</small></div>
        </a>

        <div class="sidebar-section">Genel</div>
        <a class="nav-link @(aktif == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index" title="Dashboard">
            <i class="bi bi-grid-1x2-fill"></i><span class="nav-text">Dashboard</span>
        </a>

        <div class="sidebar-section">Klinik Yönetimi</div>
        <a class="nav-link @(aktif == "Klinik" ? "active" : "")" asp-controller="Klinik" asp-action="Index" title="Klinikler">
            <i class="bi bi-hospital"></i><span class="nav-text">Klinikler</span>
        </a>
        <a class="nav-link @(aktif == "Hizmet" ? "active" : "")" asp-controller="Hizmet" asp-action="Index" title="Hizmetler">
            <i class="bi bi-clipboard2-pulse"></i><span class="nav-text">Hizmetler</span>
        </a>
        <a class="nav-link @(aktif == "UzmanlikAlani" ? "active" : "")" asp-controller="UzmanlikAlani" asp-action="Index" title="Uzmanlık Alanları">
            <i class="bi bi-award"></i><span class="nav-text">Uzmanlık Alanları</span>
        </a>

        <div class="sidebar-section">Personel & Randevu</div>
        <a class="nav-link @(aktif == "Veteriner" ? "active" : "")" asp-controller="Veteriner" asp-action="Index" title="Veterinerler">
            <i class="bi bi-person-badge"></i><span class="nav-text">Veterinerler</span>
        </a>
        <a class="nav-link @(aktif == "Randevu" ? "active" : "")" asp-controller="Randevu" asp-action="Index" title="Randevular">
            <i class="bi bi-calendar2-check"></i><span class="nav-text">Randevular</span>
        </a>

        <div class="sidebar-footer">
            <a class="nav-link" asp-controller="Home" asp-action="Index" target="_blank" title="Siteyi Görüntüle">
                <i class="bi bi-box-arrow-up-right"></i><span class="nav-text">Siteyi Görüntüle</span>
            </a>
        </div>
    </aside>
    <div class="sidebar-backdrop"></div>

    <!-- ========== ANA ALAN ========== -->
    <div class="main">
        <!-- NAVBAR -->
        <header class="topbar">
            <button type="button" class="icon-btn" id="sidebarToggle" title="Menüyü daralt/genişlet"><i class="bi bi-list"></i></button>
            <div class="topbar-title">
                <h1>@ViewData["Title"]</h1>
                <small>VetKlinik / @ViewData["Title"]</small>
            </div>

            <div class="topbar-right">
                <span class="date-pill"><i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dd MMMM yyyy, dddd")</span>

                <div class="dropdown">
                    <button class="user-btn" type="button" data-bs-toggle="dropdown">
                        <span class="avatar">@basHarf</span>
                        <span>
                            <div class="name">@adSoyad</div>
                            <div class="role">Yönetici</div>
                        </span>
                        <i class="bi bi-chevron-down small text-muted"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2">
                        <li><a class="dropdown-item" asp-controller="Home" asp-action="Index" target="_blank"><i class="bi bi-globe me-2"></i>Siteyi Görüntüle</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="AdminGiris" asp-action="Cikis" method="post">
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- BİLDİRİMLER -->
        @if (TempData["Basari"] != null)
        {
            <div class="alert alert-success alert-float alert-dismissible fade show">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Basari"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Hata"] != null)
        {
            <div class="alert alert-danger alert-float alert-dismissible fade show">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Hata"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- İÇERİK -->
        <main class="content">
            @RenderBody()
        </main>

        <!-- FOOTER -->
        <footer class="admin-footer">© @DateTime.Now.Year VetKlinik · Veteriner Kliniği Randevu ve Hasta Takip Sistemi</footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            $(function () {
                // Sidebar daralt/genişlet (masaüstünde tercih hatırlanır)
                if (localStorage.getItem('sidebarMini') === '1' && window.innerWidth > 991) {
                    $('body').addClass('sidebar-mini');
                }
                $('#sidebarToggle').on('click', function () {
                    if (window.innerWidth > 991) {
                        $('body').toggleClass('sidebar-mini');
                        localStorage.setItem('sidebarMini', $('body').hasClass('sidebar-mini') ? '1' : '0');
                    } else {
                        $('body').toggleClass('sidebar-open');
                    }
                });
                $('.sidebar-backdrop').on('click', function () {
                    $('body').removeClass('sidebar-open');
                });

                // Bildirimler 4 saniye sonra kaybolsun
                setTimeout(function () { $('.alert-float').fadeOut(400); }, 4000);
            });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>