@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="card-modern p-4 p-lg-5 text-white border-0"
     style="background: linear-gradient(135deg, #0f766e 0%, #0e7490 55%, #0284c7 100%);">
    <h2 class="fw-bold mb-2">Hoş geldiniz</h2>
    <p class="mb-0 opacity-75">Klinik, hizmet, veteriner ve randevu yönetimine sol menüden ulaşabilirsiniz.</p>
</div>

<div class="card-modern mt-4">
    <div class="empty-state">
        <div class="empty-icon"><i class="bi bi-bar-chart-line"></i></div>
        <h5 class="fw-bold">İstatistikler burada yer alacak</h5>
        <p class="mb-0">Dashboard kartları ve grafikleri randevu modülünden sonra eklenecek.</p>
    </div>
</div>