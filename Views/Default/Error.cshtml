@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
    Layout = "~/Views/DefaultLayout/Index.cshtml";
}

<section class="section">
    <div class="container text-center" style="max-width: 560px;">
        <div class="feature-icon mx-auto mb-3" style="background:#fee2e2;color:#b91c1c;"><i class="bi bi-exclamation-triangle"></i></div>
        <h2 class="fw-bold">Bir hata oluştu</h2>
        <p class="text-muted">İsteğiniz işlenirken beklenmeyen bir hata oluştu. Lütfen daha sonra tekrar deneyin.</p>
        @if (Model?.ShowRequestId == true)
        {
            <p class="small text-muted">İstek kimliği: <code>@Model.RequestId</code></p>
        }
        <a asp-controller="Default" asp-action="Index" class="btn btn-brand mt-2"><i class="bi bi-house me-1"></i> Ana Sayfaya Dön</a>
    </div>
</section>