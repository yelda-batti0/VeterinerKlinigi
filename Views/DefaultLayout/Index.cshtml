@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <title>@ViewData["Title"] - VetKlinik</title>
    @await Component.InvokeAsync("_DefaultHeadComponentPartial")
    @await Component.InvokeAsync("_DefaultStyleComponentPartial")
</head>
<body>
    @await Component.InvokeAsync("_DefaultNavbarComponentPartial")

    <!-- Bildirimler -->
    @if (TempData["Basari"] != null)
    {
        <div class="alert alert-success site-alert alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Basari"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger site-alert alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Hata"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <main>
        @RenderBody()
    </main>

    @await Component.InvokeAsync("_DefaultFooterComponentPartial")
    @await Component.InvokeAsync("_DefaultScriptComponentPartial")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>