@model VeterinerKlinigi.Entities.Hizmet
@{
    ViewData["Title"] = "Yeni Hizmet";
    ViewData["ButonMetni"] = "Hizmeti Kaydet";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-head">
    <div>
        <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Hizmetler</a>
        <h2>Yeni Hizmet</h2>
        <p>Hizmetin bağlı olduğu kliniği, süresini ve ücretini girin.</p>
    </div>
</div>

<form asp-action="Create" method="post">
    <partial name="_Form" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/hizmet-form.js" asp-append-version="true"></script>
}