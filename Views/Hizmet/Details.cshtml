@model VeterinerKlinigi.Entities.Hizmet
@using VeterinerKlinigi.Models
@{
    ViewData["Title"] = "Hizmet Detayı";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    var silUyari = Model.Randevular.Any()
        ? $"Bu hizmete ait {Model.Randevular.Count} randevu bulunduğu için silinemez."
        : "";
}

<div class="page-head">
    <div>
        <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Hizmetler</a>
        <h2>@Model.Ad</h2>
        <p>Hizmet bilgileri ve bu hizmeti verebilen veteriner hekimler.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-soft"><i class="bi bi-pencil me-1"></i> Düzenle</a>
        <button type="button" class="btn btn-soft text-danger"
                data-sil-url="@Url.Action("Delete", new { id = Model.Id })"
                data-sil-ad="@Model.Ad"
                data-sil-uyari="@silUyari">
            <i class="bi bi-trash3 me-1"></i> Sil
        </button>
    </div>
</div>

<!-- ÜST BİLGİ KARTI -->
<div class="card-modern mb-4">
    <div class="d-flex flex-wrap gap-4 align-items-center p-4">
        <div class="ec-icon xl"><i class="bi @HizmetHelper.Ikon(Model.Ad)"></i></div>
        <div class="flex-grow-1 min-w-0">
            <h4 class="fw-bold mb-2">@Model.Ad</h4>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Klinik" asp-action="Details" asp-route-id="@Model.KlinikId" class="chip text-decoration-none"><i class="bi bi-hospital"></i>@Model.Klinik?.Ad</a>
                <span class="chip blue"><i class="bi bi-stopwatch"></i>@HizmetHelper.SureMetni(Model.SureDakika)</span>
            </div>
        </div>
        <div class="text-end">
            <div class="price-tag" style="font-size: 30px;">@Model.Ucret.ToString("N2")<small>₺</small></div>
            <small class="text-muted">Hizmet ücreti</small>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Aciklama))
    {
        <div class="px-4 pb-4 text-muted">@Model.Aciklama</div>
    }
    <div class="detail-stats">
        <div><strong>@HizmetHelper.SureMetni(Model.SureDakika)</strong><span>Randevu süresi</span></div>
        <div><strong>@Model.Veterinerler.Count</strong><span>Hizmeti veren veteriner</span></div>
        <div><strong>@Model.Randevular.Count</strong><span>Toplam randevu</span></div>
    </div>
</div>

<!-- VETERİNERLER -->
<div class="card-modern">
    <div class="card-modern-header">
        <span><i class="bi bi-person-badge me-2 text-muted"></i>Bu Hizmeti Veren Veterinerler</span>
        <a asp-controller="Veteriner" asp-action="Index" asp-route-klinikId="@Model.KlinikId" class="btn btn-sm btn-soft">Veterinerleri Yönet</a>
    </div>
    @if (!Model.Veterinerler.Any())
    {
        <partial name="_AdminBosDurum" model='@(new BosDurumViewModel
                 {
                     Ikon = "bi-person-exclamation",
                     Baslik = "Veteriner atanmamış",
                     Aciklama = "Bu hizmete randevu alınabilmesi için en az bir veterinere atanması gerekir. Veteriner düzenleme sayfasından bu hizmeti seçebilirsiniz."
                 })' />
    }
    else
    {
        @foreach (var v in Model.Veterinerler.OrderBy(v => v.Ad))
        {
            <div class="list-row">
                <span class="avatar">@(v.Ad.Substring(0, 1))@(v.Soyad.Substring(0, 1))</span>
                <div class="flex-grow-1 min-w-0">
                    <div class="fw-semibold">@v.AdSoyad</div>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        @foreach (var u in v.UzmanlikAlanlari)
                        {
                            <span class="chip blue">@u.Ad</span>
                        }
                    </div>
                </div>
                <a asp-controller="Veteriner" asp-action="Edit" asp-route-id="@v.Id" class="btn-icon edit" title="Düzenle"><i class="bi bi-pencil"></i></a>
            </div>
        }
    }
</div>

<partial name="_AdminSilModal" />

@section Scripts {
    <script src="~/js/admin-liste.js" asp-append-version="true"></script>
}