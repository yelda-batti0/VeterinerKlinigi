@model VeterinerKlinigi.Models.HizmetIndexViewModel
@using VeterinerKlinigi.Models
@{
    ViewData["Title"] = "Hizmetler";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<!-- BAŞLIK -->
<div class="page-head">
    <div>
        <div class="eyebrow"><i class="bi bi-clipboard2-pulse"></i> Klinik Yönetimi</div>
        <h2>Hizmetler</h2>
        <p>Kliniklerin sunduğu muayene, aşı, bakım gibi hizmetleri, sürelerini ve ücretlerini yönetin.</p>
    </div>
    @if (Model.Klinikler.Any())
    {
        <a asp-action="Create" asp-route-klinikId="@Model.SeciliKlinikId" class="btn btn-brand"><i class="bi bi-plus-lg me-1"></i> Yeni Hizmet Ekle</a>
    }
</div>

<!-- İSTATİSTİKLER -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <partial name="_AdminStatKart" model='@(new StatKartViewModel { Baslik = "Toplam Hizmet", Deger = Model.ToplamHizmet.ToString(), Ikon = "bi-clipboard2-pulse", Ton = "teal" })' />
    </div>
    <div class="col-6 col-xl-3">
        <partial name="_AdminStatKart" model='@(new StatKartViewModel { Baslik = "Ortalama Ücret", Deger = Model.OrtalamaUcret.ToString("N0") + " ₺", Ikon = "bi-cash-coin", Ton = "blue" })' />
    </div>
    <div class="col-6 col-xl-3">
        <partial name="_AdminStatKart" model='@(new StatKartViewModel { Baslik = "Ortalama Süre", Deger = HizmetHelper.SureMetni(Model.OrtalamaSure), Ikon = "bi-stopwatch", Ton = "green" })' />
    </div>
    <div class="col-6 col-xl-3">
        <partial name="_AdminStatKart" model='@(new StatKartViewModel { Baslik = "Veteriner Atanmamış", Deger = Model.VeterinersizHizmet.ToString(), Ikon = "bi-exclamation-triangle", Ton = Model.VeterinersizHizmet > 0 ? "amber" : "slate" })' />
    </div>
</div>

@if (!Model.Klinikler.Any())
{
    <!-- HİÇ KLİNİK YOK -->
    <div class="card-modern">
        <partial name="_AdminBosDurum" model='@(new BosDurumViewModel
                 {
                     Ikon = "bi-hospital",
                     Baslik = "Önce bir klinik eklemelisiniz",
                     Aciklama = "Hizmetler bir kliniğe bağlı olarak tanımlanır. Başlamak için ilk kliniğinizi ekleyin.",
                     ButonMetni = "Klinik Ekle",
                     ButonUrl = Url.Action("Create", "Klinik")
                 })' />
    </div>
}
else if (!Model.Hizmetler.Any())
{
    <!-- HİÇ HİZMET YOK -->
    <div class="card-modern">
        <partial name="_AdminBosDurum" model='@(new BosDurumViewModel
                 {
                     Ikon = "bi-clipboard2-pulse",
                     Baslik = "Henüz hizmet eklenmemiş",
                     Aciklama = "Muayene, aşı, kısırlaştırma gibi hizmetleri ekleyerek randevu sistemini hazırlayın.",
                     ButonMetni = "İlk Hizmeti Ekle",
                     ButonUrl = Url.Action("Create")
                 })' />
    </div>
}
else
{
    <!-- ARAÇ ÇUBUĞU -->
    <div class="toolbar">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" class="form-control" placeholder="Hizmet, klinik veya açıklama ara..." data-liste-ara />
        </div>
        <select class="form-select" data-liste-filtre>
            <option value="">Tüm klinikler</option>
            @foreach (var k in Model.Klinikler)
            {
                <option value="@k.Id" selected="@(Model.SeciliKlinikId == k.Id)">@k.Ad</option>
            }
        </select>
        <select class="form-select" data-liste-sirala>
            <option value="ad-asc">Ada göre (A-Z)</option>
            <option value="ad-desc">Ada göre (Z-A)</option>
            <option value="ucret-asc">Ücret (artan)</option>
            <option value="ucret-desc">Ücret (azalan)</option>
            <option value="sure-asc">Süre (kısadan uzuna)</option>
            <option value="sure-desc">Süre (uzundan kısaya)</option>
            <option value="veteriner-desc">En çok veteriner</option>
        </select>
        <span class="toolbar-count"><strong data-liste-sayac>@Model.Hizmetler.Count</strong> hizmet</span>
        <div class="view-toggle">
            <button type="button" data-gorunum="grid" title="Kart görünümü"><i class="bi bi-grid-3x3-gap"></i></button>
            <button type="button" data-gorunum="list" title="Liste görünümü"><i class="bi bi-list-ul"></i></button>
        </div>
    </div>

    <!-- HİZMET KARTLARI -->
    <div class="row g-4" data-liste="hizmet">
        @foreach (var h in Model.Hizmetler)
        {
            var silUyari = h.Randevular.Any()
                ? $"Bu hizmete ait {h.Randevular.Count} randevu bulunduğu için silinemez."
                : "";

            <div class="col-xl-4 col-md-6 liste-item"
                 data-ara="@($"{h.Ad} {h.Klinik?.Ad} {h.Aciklama}")"
                 data-durum="@h.KlinikId"
                 data-ad="@h.Ad"
                 data-ucret="@((int)(h.Ucret * 100))"
                 data-sure="@h.SureDakika"
                 data-veteriner="@h.Veterinerler.Count">

                <div class="entity-card">
                    <div class="ec-head">
                        <div class="ec-icon"><i class="bi @HizmetHelper.Ikon(h.Ad)"></i></div>
                        <div class="flex-grow-1 min-w-0">
                            <h3 class="ec-title text-truncate" title="@h.Ad">@h.Ad</h3>
                            <div class="ec-sub text-truncate"><i class="bi bi-hospital me-1"></i>@h.Klinik?.Ad</div>
                        </div>
                        <span class="chip blue"><i class="bi bi-stopwatch"></i>@HizmetHelper.SureMetni(h.SureDakika)</span>
                    </div>

                    <div class="ec-body">
                        @if (!string.IsNullOrWhiteSpace(h.Aciklama))
                        {
                            <p class="text-muted small line-clamp-2 mb-0">@h.Aciklama</p>
                        }
                        else
                        {
                            <p class="text-muted small fst-italic mb-0">Açıklama eklenmemiş</p>
                        }

                        <div class="metric-strip">
                            <div class="metric"><strong>@h.Ucret.ToString("N2") ₺</strong><span>Ücret</span></div>
                            <div class="metric"><strong>@h.Veterinerler.Count</strong><span>Veteriner</span></div>
                        </div>

                        @if (!h.Veterinerler.Any())
                        {
                            <div class="mt-2"><span class="chip warn"><i class="bi bi-exclamation-triangle"></i>Veteriner atanmamış</span></div>
                        }
                    </div>

                    <div class="ec-foot">
                        <a asp-action="Details" asp-route-id="@h.Id" class="btn-detail"><i class="bi bi-eye"></i> Detayları Gör</a>
                        <a asp-action="Edit" asp-route-id="@h.Id" class="btn-icon edit" title="Düzenle"><i class="bi bi-pencil"></i></a>
                        <button type="button" class="btn-icon delete" title="Sil"
                                data-sil-url="@Url.Action("Delete", new { id = h.Id })"
                                data-sil-ad="@h.Ad"
                                data-sil-uyari="@silUyari">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- ARAMADA SONUÇ YOK -->
    <div class="card-modern d-none" data-liste-sonucyok>
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-search"></i></div>
            <h5 class="fw-bold">Eşleşen hizmet bulunamadı</h5>
            <p>Arama ifadesini ya da klinik filtresini değiştirerek tekrar deneyin.</p>
            <button type="button" class="btn btn-soft" data-liste-temizle><i class="bi bi-x-circle me-1"></i> Filtreleri temizle</button>
        </div>
    </div>
}

<partial name="_AdminSilModal" />

@section Scripts {
    <script src="~/js/admin-liste.js" asp-append-version="true"></script>
}