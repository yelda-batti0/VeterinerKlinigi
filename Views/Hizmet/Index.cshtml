@model List<VeterinerKlinigi.Entities.Hizmet>
@{
    ViewData["Title"] = "Hizmetler";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Hizmetler</h4>
    <a asp-action="Create" asp-route-klinikId="@ViewBag.SeciliKlinikId" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Yeni Hizmet</a>
</div>

<form method="get" class="row g-2 mb-3" style="max-width: 500px;">
    <div class="col">
        <select name="klinikId" asp-items="ViewBag.Klinikler" class="form-select" onchange="this.form.submit()">
            <option value="">Tüm Klinikler</option>
        </select>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Hizmet</th>
                    <th>Klinik</th>
                    <th>Süre</th>
                    <th>Ücret</th>
                    <th>Veteriner</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Hizmet bulunamadı.</td></tr>
                }
                @foreach (var h in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@h.Ad</div>
                            @if (!string.IsNullOrEmpty(h.Aciklama))
                            {
                                <small class="text-muted">@h.Aciklama</small>
                            }
                        </td>
                        <td>@h.Klinik?.Ad</td>
                        <td>@h.SureDakika dk</td>
                        <td>@h.Ucret.ToString("N2") ₺</td>
                        <td><span class="badge bg-secondary">@h.Veterinerler.Count</span></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@h.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@h.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>