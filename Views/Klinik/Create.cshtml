@model VeterinerKlinigi.Entities.Klinik
@{
    ViewData["Title"] = "Yeni Klinik";
    ViewData["ButonMetni"] = "Kliniği Kaydet";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-head">
    <div>
        <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Klinikler</a>
        <h2>Yeni Klinik</h2>
        <p>Kliniğin temel bilgilerini, konumunu ve çalışma saatlerini girin.</p>
    </div>
</div>

<form asp-action="Create" method="post">
    <partial name="_Form" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/klinik-form.js" asp-append-version="true"></script>
}