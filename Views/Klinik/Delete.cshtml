@model VeterinerKlinigi.Entities.Klinik
@{
    ViewData["Title"] = "Klinik Sil";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="card shadow-sm border-danger" style="max-width: 600px;">
    <div class="card-header bg-danger text-white fw-semibold">Bu kliniği silmek istediğinize emin misiniz?</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Klinik Adı</dt><dd class="col-sm-8">@Model.Ad</dd>
            <dt class="col-sm-4">Adres</dt><dd class="col-sm-8">@Model.Adres</dd>
            <dt class="col-sm-4">Çalışma Saatleri</dt><dd class="col-sm-8">@Model.AcilisSaati.ToString(@"hh\:mm") - @Model.KapanisSaati.ToString(@"hh\:mm")</dd>
            <dt class="col-sm-4">Bağlı Hizmet</dt><dd class="col-sm-8">@Model.Hizmetler.Count</dd>
            <dt class="col-sm-4">Bağlı Veteriner</dt><dd class="col-sm-8">@Model.Veterinerler.Count</dd>
        </dl>
        <form asp-action="Delete" method="post" class="mt-4 d-flex gap-2">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Evet, Sil</button>
            <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
        </form>
    </div>
</div>