@model VeterinerKlinigi.Entities.Klinik
@using VeterinerKlinigi.Models
@{
    ViewData["Title"] = "Klinik Detayı";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    var acik = KlinikHelper.SuAnAcikMi(Model);
    var silUyari = (Model.Hizmetler.Any() || Model.Veterinerler.Any())
        ? $"Bu kliniğe bağlı {Model.Hizmetler.Count} hizmet ve {Model.Veterinerler.Count} veteriner bulunduğu için silinemez. Önce bunları kaldırmalısınız."
        : "";
}

<div class="page-head">
    <div>
        <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Klinikler</a>
        <h2>@Model.Ad</h2>
        <p>Klinik bilgileri, sunulan hizmetler ve veteriner ekibi.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-soft"><i class="bi bi-pencil me-1"></i> Düzenle</a>
        <button type="button" class="btn btn-soft text-danger"
                data-sil-url="@Url.Action("Delete", new { id = Model.Id })"
                data-sil-ad="@Model.Ad"
                data-sil-uyari="@silUyari">
            <i class="bi bi-trash3 me-1"></i> Sil
        </button>
    </div>
</div>

<!-- ÜST BİLGİ KARTI -->
<div class="card-modern mb-4">
    <div class="d-flex flex-wrap gap-4 align-items-center p-4">
        <div class="ec-icon xl"><i class="bi bi-hospital"></i></div>
        <div class="flex-grow-1 min-w-0">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <h4 class="fw-bold mb-0">@Model.Ad</h4>
                @if (acik)
                {
                    <span class="chip"><span class="dot"></span>Şu an açık</span>
                }
                else
                {
                    <span class="chip gray"><span class="dot"></span>Şu an kapalı</span>
                }
            </div>
            <div class="d-flex flex-wrap gap-4">
                <div class="info-row">
                    <i class="bi bi-geo-alt"></i>
                    <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(Model.Adres)" target="_blank">@Model.Adres</a>
                </div>
                <div class="info-row">
                    <i class="bi bi-telephone"></i>
                    @if (!string.IsNullOrWhiteSpace(Model.Telefon))
                    {
                        <a href="tel:@Model.Telefon.Replace(" ", "")">@Model.Telefon</a>
                    }
                    else
                    {
                        <span class="text-muted">Telefon eklenmemiş</span>
                    }
                </div>
                <div class="info-row">
                    <i class="bi bi-clock"></i>
                    @Model.AcilisSaati.ToString(@"hh\:mm") – @Model.KapanisSaati.ToString(@"hh\:mm")
                </div>
            </div>
        </div>
    </div>
    <div class="detail-stats">
        <div><strong>@Model.Hizmetler.Count</strong><span>Sunulan hizmet</span></div>
        <div><strong>@Model.Veterinerler.Count</strong><span>Veteriner hekim</span></div>
        <div><strong>@KlinikHelper.GunlukCalismaSuresi(Model)</strong><span>Günlük çalışma süresi</span></div>
    </div>
</div>

<div class="row g-4">
    <!-- HİZMETLER -->
    <div class="col-lg-6">
        <div class="card-modern h-100">
            <div class="card-modern-header">
                <span><i class="bi bi-clipboard2-pulse me-2 text-muted"></i>Hizmetler</span>
                <a asp-controller="Hizmet" asp-action="Create" asp-route-klinikId="@Model.Id" class="btn btn-sm btn-soft"><i class="bi bi-plus-lg"></i> Hizmet Ekle</a>
            </div>
            @if (!Model.Hizmetler.Any())
            {
                <partial name="_AdminBosDurum" model='@(new BosDurumViewModel { Ikon = "bi-clipboard2-pulse", Baslik = "Hizmet yok", Aciklama = "Bu klinik için henüz hizmet tanımlanmamış." })' />
            }
            else
            {
                @foreach (var h in Model.Hizmetler.OrderBy(h => h.Ad))
                {
                    <div class="list-row">
                        <div class="stat-icon tone-teal" style="width:38px;height:38px;font-size:16px;"><i class="bi bi-clipboard2-pulse"></i></div>
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-semibold">@h.Ad</div>
                            <small class="text-muted"><i class="bi bi-stopwatch me-1"></i>@h.SureDakika dk</small>
                        </div>
                        <div class="fw-bold">@h.Ucret.ToString("N2") ₺</div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- VETERİNERLER -->
    <div class="col-lg-6">
        <div class="card-modern h-100">
            <div class="card-modern-header">
                <span><i class="bi bi-person-badge me-2 text-muted"></i>Veteriner Ekibi</span>
                <a asp-controller="Veteriner" asp-action="Create" asp-route-klinikId="@Model.Id" class="btn btn-sm btn-soft"><i class="bi bi-plus-lg"></i> Veteriner Ekle</a>
            </div>
            @if (!Model.Veterinerler.Any())
            {
                <partial name="_AdminBosDurum" model='@(new BosDurumViewModel { Ikon = "bi-person-badge", Baslik = "Veteriner yok", Aciklama = "Bu klinikte henüz görevli veteriner bulunmuyor." })' />
            }
            else
            {
                @foreach (var v in Model.Veterinerler.OrderBy(v => v.Ad))
                {
                    <div class="list-row">
                        <span class="avatar">@(v.Ad.Substring(0, 1))@(v.Soyad.Substring(0, 1))</span>
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-semibold">@v.AdSoyad</div>
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                @foreach (var u in v.UzmanlikAlanlari)
                                {
                                    <span class="chip blue">@u.Ad</span>
                                }
                            </div>
                        </div>
                        <a asp-controller="Veteriner" asp-action="Edit" asp-route-id="@v.Id" class="btn-icon edit" title="Düzenle"><i class="bi bi-pencil"></i></a>
                    </div>
                }
            }
        </div>
    </div>
</div>

<partial name="_AdminSilModal" />

@section Scripts {
    <script src="~/js/admin-liste.js" asp-append-version="true"></script>
}