@model VeterinerKlinigi.Entities.Klinik
@{
    ViewData["Title"] = "Klinik Düzenle";
    ViewData["ButonMetni"] = "Değişiklikleri Kaydet";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-head">
    <div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="back-link"><i class="bi bi-arrow-left"></i> Klinik detayı</a>
        <h2>Klinik Düzenle</h2>
        <p><strong>@Model.Ad</strong> kliniğinin bilgilerini güncelleyin.</p>
    </div>
</div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <partial name="_Form" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/klinik-form.js" asp-append-version="true"></script>
}