@model List<VeterinerKlinigi.Entities.Klinik>
@{
    ViewData["Title"] = "Klinikler";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Klinikler</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Yeni Klinik</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Klinik Adı</th>
                    <th>Adres</th>
                    <th>Telefon</th>
                    <th>Çalışma Saatleri</th>
                    <th>Hizmet</th>
                    <th>Veteriner</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Henüz klinik eklenmemiş.</td></tr>
                }
                @foreach (var k in Model)
                {
                    <tr>
                        <td class="fw-semibold">@k.Ad</td>
                        <td>@k.Adres</td>
                        <td>@k.Telefon</td>
                        <td>@k.AcilisSaati.ToString(@"hh\:mm") - @k.KapanisSaati.ToString(@"hh\:mm")</td>
                        <td><span class="badge bg-info text-dark">@k.Hizmetler.Count</span></td>
                        <td><span class="badge bg-secondary">@k.Veterinerler.Count</span></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@k.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@k.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>