@model AppUser?
@{
    var adSoyad = Model != null ? $"{Model.Ad} {Model.Soyad}" : "Yönetici";
    var basHarf = !string.IsNullOrEmpty(Model?.Ad) ? Model.Ad.Substring(0, 1).ToUpper() : "A";
}

<header class="topbar">
    <!-- Masaüstü: menüyü daralt/genişlet -->
    <button type="button" class="icon-btn d-none d-lg-grid" id="sidebarToggle" title="Menüyü daralt/genişlet">
        <i class="bi bi-list"></i>
    </button>
    <!-- Mobil: menüyü aç -->
    <button type="button" class="icon-btn d-grid d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar" title="Menü">
        <i class="bi bi-list"></i>
    </button>

    <div class="topbar-title">
        <h1>@ViewData["Title"]</h1>
        <small>VetKlinik / @ViewData["Title"]</small>
    </div>

    <div class="topbar-right">
        <span class="date-pill d-none d-md-inline"><i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dd MMMM yyyy, dddd")</span>

        <div class="dropdown">
            <button class="user-btn" type="button" data-bs-toggle="dropdown">
                <span class="avatar">@basHarf</span>
                <span class="d-none d-md-block">
                    <span class="name d-block">@adSoyad</span>
                    <span class="role d-block">Yönetici</span>
                </span>
                <i class="bi bi-chevron-down small text-muted"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2">
                <li><a class="dropdown-item" asp-controller="Default" asp-action="Index" target="_blank"><i class="bi bi-globe me-2"></i>Siteyi Görüntüle</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form asp-controller="AdminGiris" asp-action="Cikis" method="post">
                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap</button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</header>