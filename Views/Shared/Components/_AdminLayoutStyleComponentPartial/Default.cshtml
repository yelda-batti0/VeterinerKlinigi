<style>
    /* =========================================
       DEĞİŞKENLER
       ========================================= */
    :root {
        --brand: #0d9488;
        --brand-dark: #0f766e;
        --brand-2: #0284c7;
        --brand-light: #ccfbf1;
        --bg: #f1f6f9;
        --text: #0f172a;
        --muted: #64748b;
        --border: #e2e8f0;
        --sidebar-w: 260px;
        --sidebar-w-mini: 80px;
        --radius: 16px;
        --shadow: 0 1px 2px rgba(15,23,42,.04), 0 8px 24px rgba(15,23,42,.06);
    }

    body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); color: var(--text); margin: 0; }
    .min-w-0 { min-width: 0; }

    /* =========================================
       SIDEBAR
       ========================================= */
    .sidebar {
        position: fixed; top: 0; bottom: 0; left: 0; width: var(--sidebar-w); z-index: 1040;
        background: linear-gradient(180deg, #0f766e 0%, #0e7490 55%, #075985 100%);
        color: #fff; flex-direction: column; padding: 20px 14px; overflow-y: auto;
        transition: width .25s ease;
    }
    .sidebar-brand { display: flex; align-items: center; gap: 12px; padding: 6px 8px 22px; color: #fff; text-decoration: none; }
    .brand-icon { width: 44px; height: 44px; border-radius: 12px; background: rgba(255,255,255,.18); display: grid; place-items: center; font-size: 22px; flex-shrink: 0; }
    .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
    .brand-text span { font-weight: 800; font-size: 18px; }
    .brand-text small { opacity: .75; font-size: 12px; }
    .sidebar-section { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; opacity: .6; padding: 16px 12px 6px; white-space: nowrap; }
    .sidebar .nav-link, .mobile-sidebar .nav-link {
        display: flex; align-items: center; gap: 12px; color: rgba(255,255,255,.82);
        padding: 11px 12px; border-radius: 12px; font-weight: 500; font-size: 14.5px; white-space: nowrap;
        transition: background .15s, color .15s;
    }
    .sidebar .nav-link i, .mobile-sidebar .nav-link i { font-size: 18px; width: 22px; text-align: center; flex-shrink: 0; }
    .sidebar .nav-link:hover, .mobile-sidebar .nav-link:hover { background: rgba(255,255,255,.12); color: #fff; }
    .sidebar .nav-link.active, .mobile-sidebar .nav-link.active { background: #fff; color: var(--brand-dark); font-weight: 700; box-shadow: 0 6px 16px rgba(0,0,0,.12); }
    .sidebar-footer { margin-top: auto; padding-top: 16px; border-top: 1px solid rgba(255,255,255,.15); }

    /* Daraltılmış sidebar (masaüstü) */
    body.sidebar-mini .sidebar { width: var(--sidebar-w-mini); }
    body.sidebar-mini .main { margin-left: var(--sidebar-w-mini); }
    body.sidebar-mini .sidebar .brand-text,
    body.sidebar-mini .sidebar .sidebar-section,
    body.sidebar-mini .sidebar .nav-text { display: none; }
    body.sidebar-mini .sidebar .nav-link { justify-content: center; }

    /* Mobil sidebar (offcanvas) */
    .mobile-sidebar { background: linear-gradient(180deg, #0f766e 0%, #0e7490 55%, #075985 100%); color: #fff; width: 280px !important; }
    .mobile-sidebar .btn-close { filter: invert(1); }

    /* =========================================
       ANA ALAN
       ========================================= */
    .main { margin-left: var(--sidebar-w); min-height: 100vh; display: flex; flex-direction: column; transition: margin-left .25s ease; }
    .topbar {
        position: sticky; top: 0; z-index: 1030; display: flex; align-items: center; gap: 16px;
        background: rgba(255,255,255,.88); backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border); padding: 14px 28px;
    }
    .icon-btn { width: 42px; height: 42px; border-radius: 12px; border: 1px solid var(--border); background: #fff; place-items: center; font-size: 20px; color: var(--text); }
    .icon-btn:hover { background: var(--brand-light); color: var(--brand-dark); border-color: transparent; }
    .topbar-title h1 { font-size: 19px; font-weight: 700; margin: 0; }
    .topbar-title small { color: var(--muted); font-size: 13px; }
    .topbar-right { margin-left: auto; display: flex; align-items: center; gap: 12px; }
    .date-pill { background: #fff; border: 1px solid var(--border); border-radius: 999px; padding: 8px 14px; font-size: 13px; color: var(--muted); }
    .user-btn { display: flex; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--border); border-radius: 999px; padding: 5px 14px 5px 5px; }
    .user-btn .name { font-weight: 600; font-size: 14px; line-height: 1.1; text-align: left; }
    .user-btn .role { font-size: 12px; color: var(--muted); text-align: left; }
    .content { padding: 28px; flex: 1; }
    .admin-footer { padding: 16px 28px; color: var(--muted); font-size: 13px; }
    .alert-float { position: fixed; top: 84px; right: 24px; z-index: 1060; min-width: 320px; border-radius: 12px; box-shadow: 0 12px 30px rgba(15,23,42,.15); border: none; }
    .alert-float + .alert-float { top: 150px; }

    @@media (max-width: 991px) {
        .main { margin-left: 0 !important; }
        .content { padding: 18px; }
        .topbar { padding: 12px 18px; }
    }

    /* =========================================
       ORTAK BİLEŞENLER (tüm admin sayfaları)
       ========================================= */

    /* Avatar */
    .avatar { width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, var(--brand), var(--brand-2)); color: #fff; display: grid; place-items: center; font-weight: 700; font-size: 14px; flex-shrink: 0; }
    .avatar-lg { width: 56px; height: 56px; font-size: 20px; border-radius: 16px; }
    .avatar-stack { display: flex; align-items: center; }
    .avatar-stack .avatar { width: 32px; height: 32px; font-size: 12px; border: 2px solid #fff; margin-left: -8px; }
    .avatar-stack .avatar:first-child { margin-left: 0; }

    /* Sayfa başlığı */
    .page-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
    .page-head h2 { font-size: 24px; font-weight: 800; margin: 0; }
    .page-head p { color: var(--muted); margin: 4px 0 0; }
    .page-head .eyebrow { display: inline-flex; align-items: center; gap: 6px; margin-bottom: 6px; font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--brand); }
    .back-link { display: inline-flex; align-items: center; gap: 6px; margin-bottom: 6px; font-size: 13px; font-weight: 600; color: var(--muted); text-decoration: none; }
    .back-link:hover { color: var(--brand); }

    /* Kart */
    .card-modern { background: #fff; border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); }
    .card-modern-header { padding: 18px 22px; border-bottom: 1px solid var(--border); font-weight: 700; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .card-modern-body { padding: 22px; }

    /* Butonlar */
    .btn-brand { background: linear-gradient(135deg, var(--brand), var(--brand-2)); color: #fff; border: none; border-radius: 12px; padding: 10px 18px; font-weight: 600; }
    .btn-brand:hover { color: #fff; filter: brightness(1.05); box-shadow: 0 8px 20px rgba(13,148,136,.3); }
    .btn-brand:disabled { opacity: .5; }
    .btn-soft { border-radius: 12px; border: 1px solid var(--border); background: #fff; font-weight: 500; padding: 10px 18px; }
    .btn-soft:hover { background: #f8fafc; }
    .btn-icon { width: 36px; height: 36px; border-radius: 10px; display: inline-grid; place-items: center; border: none; text-decoration: none; transition: transform .15s, filter .15s; }
    .btn-icon:hover { transform: translateY(-1px); filter: brightness(.94); }
    .btn-icon.edit { background: #fef3c7; color: #b45309; }
    .btn-icon.delete { background: #fef2f2; color: #dc2626; }
    .btn-icon.info { background: #e0f2fe; color: #0369a1; }

    /* Etiket (chip) */
    .chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; font-size: 12.5px; font-weight: 600; background: var(--brand-light); color: var(--brand-dark); }
    .chip.blue { background: #e0f2fe; color: #0369a1; }
    .chip.gray { background: #f1f5f9; color: #475569; }
    .chip.warn { background: #fef3c7; color: #92400e; }
    .chip.danger { background: #fee2e2; color: #b91c1c; }
    .chip .dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }

    /* Renk tonları (ikon kutuları) */
    .tone-teal { background: #ccfbf1; color: #0f766e; }
    .tone-blue { background: #e0f2fe; color: #0369a1; }
    .tone-green { background: #dcfce7; color: #15803d; }
    .tone-slate { background: #f1f5f9; color: #475569; }
    .tone-amber { background: #fef3c7; color: #b45309; }
    .tone-red { background: #fee2e2; color: #b91c1c; }

    /* İstatistik kartı */
    .stat-card { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 16px 18px; display: flex; align-items: center; gap: 14px; height: 100%; transition: border-color .2s, box-shadow .2s; }
    .stat-card:hover { border-color: #cbd5e1; box-shadow: var(--shadow); }
    .stat-icon { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; font-size: 20px; flex-shrink: 0; }
    .stat-value { font-size: 24px; font-weight: 800; line-height: 1; }
    .stat-label { font-size: 13px; color: var(--muted); margin-top: 4px; }

    /* Araç çubuğu (arama, filtre, sıralama, görünüm) */
    .toolbar { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 12px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 20px; }
    .search-box { position: relative; flex: 1 1 260px; }
    .search-box i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--muted); }
    .search-box input { padding-left: 40px; height: 44px; }
    .toolbar .form-select { width: auto; min-width: 170px; height: 44px; }
    .toolbar-count { font-size: 13px; color: var(--muted); margin-left: auto; padding: 0 6px; white-space: nowrap; }
    .view-toggle { display: inline-flex; background: #f1f5f9; border-radius: 12px; padding: 4px; }
    .view-toggle button { border: none; background: transparent; width: 38px; height: 36px; border-radius: 9px; color: var(--muted); font-size: 16px; transition: all .15s; }
    .view-toggle button.active { background: #fff; color: var(--brand-dark); box-shadow: 0 1px 3px rgba(15,23,42,.12); }

    /* Varlık kartı (klinik, hizmet, veteriner listeleri) */
    .entity-card { background: #fff; border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); height: 100%; display: flex; flex-direction: column; transition: transform .2s, box-shadow .2s; }
    .entity-card:hover { transform: translateY(-4px); box-shadow: 0 16px 32px rgba(15,23,42,.10); }
    .entity-card .ec-head { padding: 20px; display: flex; gap: 14px; align-items: center; }
    .entity-card .ec-body { padding: 0 20px 16px; flex: 1; }
    .entity-card .ec-foot { padding: 14px 20px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 8px; }
    .ec-icon { width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center; font-size: 22px; flex-shrink: 0; background: var(--brand-light); color: var(--brand-dark); }
    .ec-icon.xl { width: 72px; height: 72px; border-radius: 20px; font-size: 32px; }
    .ec-title { font-weight: 700; font-size: 16.5px; margin: 0; line-height: 1.3; }
    .ec-sub { font-size: 13px; color: var(--muted); }
    .ec-foot .btn-detail { margin-right: auto; display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; border-radius: 10px; font-size: 14px; font-weight: 600; color: var(--brand-dark); text-decoration: none; transition: background .15s; }
    .ec-foot .btn-detail:hover { background: var(--brand-light); }
    .info-row { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; color: #334155; padding: 5px 0; }
    .info-row i { color: #94a3b8; font-size: 15px; margin-top: 1px; width: 18px; text-align: center; flex-shrink: 0; }
    .info-row a { color: inherit; text-decoration: none; }
    .info-row a:hover { color: var(--brand); }
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .metric-strip { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 14px; }
    .metric { background: #f8fafc; border: 1px solid #eef2f6; border-radius: 12px; padding: 10px 12px; }
    .metric strong { display: block; font-size: 18px; font-weight: 800; line-height: 1.1; }
    .metric span { font-size: 12px; color: var(--muted); }
    .liste-item { animation: fadeUp .35s ease both; }
    @@keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

    /* Liste görünümü (kart yerine satır) */
    .liste-gorunum > .liste-item { width: 100% !important; }
    .liste-gorunum .entity-card { flex-direction: row; align-items: stretch; }
    .liste-gorunum .entity-card:hover { transform: none; }
    .liste-gorunum .entity-card .ec-head { flex: 0 0 300px; }
    .liste-gorunum .entity-card .ec-body { padding: 16px 20px; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 28px; }
    .liste-gorunum .entity-card .metric-strip { margin-top: 0; }
    .liste-gorunum .entity-card .ec-foot { border-top: none; border-left: 1px solid var(--border); align-items: center; }
    @@media (max-width: 991px) {
        .liste-gorunum .entity-card { flex-direction: column; }
        .liste-gorunum .entity-card .ec-head { flex: none; }
        .liste-gorunum .entity-card .ec-foot { border-left: none; border-top: 1px solid var(--border); }
    }

    /* Boş durum */
    .empty-state { text-align: center; padding: 60px 20px; color: var(--muted); }
    .empty-state h5 { color: var(--text); }
    .empty-icon { width: 84px; height: 84px; border-radius: 24px; margin: 0 auto 16px; background: var(--brand-light); color: var(--brand-dark); display: grid; place-items: center; font-size: 36px; }

    /* Silme onayı */
    .modal-icon { width: 64px; height: 64px; border-radius: 50%; margin: 0 auto 14px; background: #fef2f2; color: #dc2626; display: grid; place-items: center; font-size: 28px; }

    /* Detay sayfası */
    .detail-stats { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--border); }
    .detail-stats > div { padding: 16px 24px; }
    .detail-stats > div + div { border-left: 1px solid var(--border); }
    .detail-stats strong { display: block; font-size: 20px; font-weight: 800; }
    .detail-stats span { font-size: 13px; color: var(--muted); }
    @@media (max-width: 767px) {
        .detail-stats { grid-template-columns: 1fr; }
        .detail-stats > div + div { border-left: none; border-top: 1px solid var(--border); }
    }
    .list-row { display: flex; align-items: center; gap: 12px; padding: 14px 22px; border-bottom: 1px solid #f1f5f9; }
    .list-row:last-child { border-bottom: none; }
    .list-row:hover { background: #fafcfd; }
    .price-tag { font-size: 20px; font-weight: 800; color: var(--text); line-height: 1; }
    .price-tag small { font-size: 13px; color: var(--muted); font-weight: 600; margin-left: 2px; }

    /* Formlar */
    .form-control, .form-select { border-radius: 10px; border-color: var(--border); padding: .6rem .85rem; }
    .form-control:focus, .form-select:focus { border-color: var(--brand); box-shadow: 0 0 0 .2rem rgba(13,148,136,.15); }
    .form-check-input:checked { background-color: var(--brand); border-color: var(--brand); }
    .form-label { font-weight: 600; font-size: 14px; }
    .form-section-title { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 15px; margin-bottom: 16px; }
    .form-section-title .stat-icon { width: 34px; height: 34px; font-size: 16px; border-radius: 10px; }
    .form-section + .form-section { border-top: 1px dashed var(--border); padding-top: 22px; margin-top: 22px; }
    .form-actions { padding: 16px 24px; border-top: 1px solid var(--border); background: #fafcfd; display: flex; justify-content: flex-end; gap: 10px; border-radius: 0 0 var(--radius) var(--radius); }
    .preview-sticky { position: sticky; top: 96px; }
    .preview-label { font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
    .quick-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .quick-chip { border: 1px solid var(--border); background: #fff; border-radius: 999px; padding: 4px 12px; font-size: 13px; font-weight: 600; color: #475569; transition: all .15s; }
    .quick-chip:hover, .quick-chip.active { background: var(--brand-light); border-color: transparent; color: var(--brand-dark); }
    .char-count { font-size: 12px; color: var(--muted); }

    /* Seçilebilir kartlar (checkbox yerine) */
    .select-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 10px; }
    .select-card { position: relative; cursor: pointer; margin: 0; }
    .select-card input { position: absolute; opacity: 0; pointer-events: none; }
    .select-card .sc-body { display: flex; align-items: center; gap: 10px; padding: 10px 12px; height: 100%; border: 1px solid var(--border); border-radius: 12px; background: #fff; transition: all .15s; }
    .select-card .sc-icon { width: 32px; height: 32px; border-radius: 9px; display: grid; place-items: center; background: #f1f5f9; color: #64748b; font-size: 15px; flex-shrink: 0; }
    .select-card .sc-title { font-weight: 600; font-size: 14px; line-height: 1.2; }
    .select-card .sc-sub { font-size: 12px; color: var(--muted); }
    .select-card .sc-check { margin-left: auto; color: transparent; font-size: 18px; }
    .select-card:hover .sc-body { border-color: #cbd5e1; }
    .select-card input:checked + .sc-body { border-color: var(--brand); background: #f0fdfa; box-shadow: 0 0 0 3px rgba(13,148,136,.12); }
    .select-card input:checked + .sc-body .sc-icon { background: var(--brand); color: #fff; }
    .select-card input:checked + .sc-body .sc-check { color: var(--brand); }
    .select-card.compact .sc-body { justify-content: center; padding: 9px 6px; font-weight: 600; font-size: 13px; }
</style>