@model AppUser?
@{
    var anaSayfa = Url.Action("Index", "Default");
}

<nav class="navbar navbar-expand-lg site-nav sticky-top">
    <div class="container">
        <a class="site-brand" asp-controller="Default" asp-action="Index">
            <span class="brand-icon"><i class="bi bi-heart-pulse-fill"></i></span> VetKlinik
        </a>

        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#siteMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="siteMenu">
            <ul class="navbar-nav mx-auto gap-lg-1 my-3 my-lg-0">
                <li class="nav-item"><a class="nav-link" href="@anaSayfa">Ana Sayfa</a></li>
                <li class="nav-item"><a class="nav-link" href="@(anaSayfa)#hizmetler">Hizmetler</a></li>
                <li class="nav-item"><a class="nav-link" href="@(anaSayfa)#klinikler">Klinikler</a></li>
                <li class="nav-item"><a class="nav-link" href="@(anaSayfa)#veterinerler">Veterinerler</a></li>
            </ul>

            <div class="d-flex gap-2 align-items-center">
                @if (Model == null)
                {
                    <a asp-controller="Hesap" asp-action="Login" class="btn btn-soft">Giriş Yap</a>
                    <a asp-controller="Hesap" asp-action="Register" class="btn btn-brand">Kayıt Ol</a>
                }
                else
                {
                    <div class="dropdown">
                        <button class="btn btn-soft dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i> @Model.Ad @Model.Soyad
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2">
                            @if (User.IsInRole(Roller.Admin))
                            {
                                <li><a class="dropdown-item" href="/admin"><i class="bi bi-speedometer2 me-2"></i>Yönetim Paneli</a></li>
                                <li><hr class="dropdown-divider" /></li>
                            }
                            <li>
                                <form asp-controller="Hesap" asp-action="Cikis" method="post">
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
</nav>