<style>
    :root {
        --brand: #0d9488;
        --brand-dark: #0f766e;
        --brand-2: #0284c7;
        --brand-light: #ccfbf1;
        --bg: #f8fbfc;
        --text: #0f172a;
        --muted: #64748b;
        --border: #e2e8f0;
        --radius: 18px;
        --shadow: 0 1px 2px rgba(15,23,42,.04), 0 10px 30px rgba(15,23,42,.07);
    }

    html {
        scroll-behavior: smooth;
        scroll-padding-top: 80px;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background: var(--bg);
        color: var(--text);
    }

    /* ---------- Menü ---------- */
    .site-nav {
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border);
        padding: 12px 0;
    }

    .site-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
        font-size: 20px;
        color: var(--text);
        text-decoration: none;
    }

        .site-brand .brand-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--brand), var(--brand-2));
            color: #fff;
            display: grid;
            place-items: center;
            font-size: 19px;
        }

    .site-nav .nav-link {
        font-weight: 600;
        color: #334155;
        padding: 8px 14px !important;
        border-radius: 10px;
    }

        .site-nav .nav-link:hover {
            color: var(--brand-dark);
            background: var(--brand-light);
        }

    .site-alert {
        position: fixed;
        top: 84px;
        right: 24px;
        z-index: 1060;
        min-width: 320px;
        border-radius: 12px;
        border: none;
        box-shadow: 0 12px 30px rgba(15,23,42,.15);
    }

    /* ---------- Butonlar ---------- */
    .btn-brand {
        background: linear-gradient(135deg, var(--brand), var(--brand-2));
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 10px 20px;
        font-weight: 700;
    }

        .btn-brand:hover {
            color: #fff;
            filter: brightness(1.05);
            box-shadow: 0 10px 24px rgba(13,148,136,.3);
        }

    .btn-soft {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 10px 20px;
        font-weight: 600;
        color: var(--text);
    }

        .btn-soft:hover {
            background: #f1f5f9;
        }

    .btn-light-glass {
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.35);
        color: #fff;
        border-radius: 12px;
        padding: 12px 22px;
        font-weight: 700;
    }

        .btn-light-glass:hover {
            background: rgba(255,255,255,.25);
            color: #fff;
        }

    /* ---------- Giriş bölümü ---------- */
    .hero {
        position: relative;
        overflow: hidden;
        color: #fff;
        padding: 90px 0 110px;
        background: linear-gradient(135deg, #0f766e 0%, #0e7490 55%, #0284c7 100%);
    }

        .hero::before, .hero::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,.07);
        }

        .hero::before {
            width: 480px;
            height: 480px;
            right: -140px;
            top: -160px;
        }

        .hero::after {
            width: 300px;
            height: 300px;
            left: -100px;
            bottom: -140px;
        }

        .hero .badge-soft {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,255,255,.15);
            border-radius: 999px;
            padding: 6px 14px;
            font-size: 13px;
            font-weight: 600;
        }

        .hero h1 {
            font-size: clamp(32px, 5vw, 52px);
            font-weight: 800;
            line-height: 1.1;
            margin: 18px 0;
        }

        .hero p.lead {
            opacity: .9;
            max-width: 540px;
        }

    .hero-card {
        position: relative;
        z-index: 1;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.25);
        border-radius: 24px;
        padding: 28px;
        backdrop-filter: blur(6px);
    }

    .hero-stat {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 0;
    }

        .hero-stat + .hero-stat {
            border-top: 1px solid rgba(255,255,255,.2);
        }

        .hero-stat .icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: rgba(255,255,255,.2);
            display: grid;
            place-items: center;
            font-size: 22px;
        }

        .hero-stat strong {
            font-size: 26px;
            font-weight: 800;
            display: block;
            line-height: 1;
        }

        .hero-stat span {
            opacity: .85;
            font-size: 14px;
        }

    /* ---------- Bölümler ---------- */
    .section {
        padding: 80px 0;
    }

    .section-alt {
        background: #fff;
    }

    .section-head {
        text-align: center;
        max-width: 620px;
        margin: 0 auto 44px;
    }

        .section-head .eyebrow {
            color: var(--brand);
            font-weight: 700;
            font-size: 13px;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .section-head h2 {
            font-weight: 800;
            font-size: clamp(26px, 3.5vw, 36px);
            margin: 8px 0 10px;
        }

        .section-head p {
            color: var(--muted);
            margin: 0;
        }

    /* ---------- Kartlar ---------- */
    .site-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 26px;
        height: 100%;
        transition: transform .2s, box-shadow .2s;
    }

        .site-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 18px 40px rgba(15,23,42,.10);
        }

    .feature-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        display: grid;
        place-items: center;
        font-size: 26px;
        background: var(--brand-light);
        color: var(--brand-dark);
    }

    .step-no {
        position: absolute;
        top: 18px;
        right: 22px;
        font-size: 42px;
        font-weight: 800;
        color: #eef2f6;
        line-height: 1;
    }

    .chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 12.5px;
        font-weight: 600;
        background: var(--brand-light);
        color: var(--brand-dark);
    }

        .chip.blue {
            background: #e0f2fe;
            color: #0369a1;
        }

        .chip.gray {
            background: #f1f5f9;
            color: #475569;
        }

    .info-row {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        font-size: 14px;
        color: #334155;
        padding: 4px 0;
    }

        .info-row i {
            color: #94a3b8;
            width: 18px;
            text-align: center;
            flex-shrink: 0;
        }

    .avatar {
        width: 64px;
        height: 64px;
        border-radius: 20px;
        background: linear-gradient(135deg, var(--brand), var(--brand-2));
        color: #fff;
        display: grid;
        place-items: center;
        font-weight: 800;
        font-size: 22px;
        flex-shrink: 0;
    }

    .empty-box {
        text-align: center;
        color: var(--muted);
        padding: 40px 20px;
        background: #fff;
        border: 1px dashed var(--border);
        border-radius: var(--radius);
    }

    /* ---------- Alt bilgi ---------- */
    .site-footer {
        background: #0b2e35;
        color: rgba(255,255,255,.75);
        padding: 56px 0 24px;
    }

        .site-footer h6 {
            color: #fff;
            font-weight: 700;
            margin-bottom: 14px;
        }

        .site-footer a {
            color: rgba(255,255,255,.75);
            text-decoration: none;
        }

            .site-footer a:hover {
                color: #fff;
            }

        .site-footer .footer-bottom {
            border-top: 1px solid rgba(255,255,255,.1);
            margin-top: 36px;
            padding-top: 20px;
            font-size: 13px;
        }
</style>