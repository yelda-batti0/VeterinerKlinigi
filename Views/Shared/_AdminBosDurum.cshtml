@model VeterinerKlinigi.Models.BosDurumViewModel

<div class="empty-state">
    <div class="empty-icon"><i class="bi @Model.Ikon"></i></div>
    <h5 class="fw-bold">@Model.Baslik</h5>
    <p class="mb-0">@Model.Aciklama</p>
    @if (!string.IsNullOrEmpty(Model.ButonUrl))
    {
        <a href="@Model.ButonUrl" class="btn btn-brand mt-4"><i class="bi bi-plus-lg me-1"></i> @Model.ButonMetni</a>
    }
</div>