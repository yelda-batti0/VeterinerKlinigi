<div class="modal fade modal-modern" id="silModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center p-4 p-md-5">
                <div class="modal-icon"><i class="bi bi-trash3"></i></div>
                <h5 class="fw-bold mb-2">Silmek istediğinize emin misiniz?</h5>
                <p class="text-muted mb-0">
                    <strong class="text-dark" id="silModalAd"></strong> kalıcı olarak silinecek. Bu işlem geri alınamaz.
                </p>
                <div id="silModalUyari" class="alert alert-warning small text-start mt-3 mb-0 d-none"></div>

                <form id="silModalForm" method="post" asp-antiforgery="false" class="d-flex gap-2 justify-content-center mt-4">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-soft px-4" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" id="silModalButon" class="btn btn-danger rounded-3 fw-semibold px-4">
                        <i class="bi bi-trash3 me-1"></i> Evet, Sil
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>