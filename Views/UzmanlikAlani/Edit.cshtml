@model VeterinerKlinigi.Entities.UzmanlikAlani
@{
    ViewData["Title"] = "Uzmanlık Alanı Düzenle";
    ViewData["ButonMetni"] = "Değişiklikleri Kaydet";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-head">
    <div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="back-link"><i class="bi bi-arrow-left"></i> Uzmanlık detayı</a>
        <h2>Uzmanlık Alanı Düzenle</h2>
        <p><strong>@Model.Ad</strong> uzmanlık alanını güncelleyin. Değişiklik, bu uzmanlığa sahip tüm veterinerlere yansır.</p>
    </div>
</div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <partial name="_Form" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>window.mevcutUzmanliklar = @Json.Serialize(ViewBag.MevcutAdlar);</script>
    <script src="~/js/uzmanlik-form.js" asp-append-version="true"></script>
}