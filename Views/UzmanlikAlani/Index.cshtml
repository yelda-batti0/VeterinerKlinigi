@model List<VeterinerKlinigi.Entities.UzmanlikAlani>
@{
    ViewData["Title"] = "Uzmanlık Alanları";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Uzmanlık Alanları</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Yeni Uzmanlık Alanı</a>
</div>

<div class="card shadow-sm" style="max-width: 700px;">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Uzmanlık Alanı</th>
                    <th>Veteriner Sayısı</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">Henüz uzmanlık alanı eklenmemiş.</td></tr>
                }
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-semibold">@u.Ad</td>
                        <td><span class="badge bg-secondary">@u.Veterinerler.Count</span></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@u.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>