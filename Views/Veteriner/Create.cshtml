@model VeterinerKlinigi.Models.VeterinerFormViewModel
@{
    ViewData["Title"] = "Yeni Veteriner";
    ViewData["ButonMetni"] = "Kaydet ve Müsaitlik Gir";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-head">
    <div>
        <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Veterinerler</a>
        <h2>Yeni Veteriner</h2>
        <p>Hekimin bilgilerini, giriş hesabını, uzmanlıklarını ve verebildiği hizmetleri girin.</p>
    </div>
</div>

<form asp-action="Create" method="post">
    <partial name="_Form" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/veteriner-form.js" asp-append-version="true"></script>
}