    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model VeterinerKlinigi.Entities.VeterinerHekim
@using VeterinerKlinigi.Models
@{
    ViewData["Title"] = "Veteriner Detayı";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    var bugun = DateTime.Today.DayOfWeek;
    var haftalik = VeterinerHelper.HaftalikSure(Model);
    var silUyari = Model.Randevular.Any()
        ? $"Bu veterinere ait {Model.Randevular.Count} randevu bulunduğu için silinemez."
        : "";
}

<div class="page-head">
    <div>
        <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Veterinerler</a>
        <h2>@Model.AdSoyad</h2>
        <p>Hekim bilgileri, haftalık çalışma programı ve verdiği hizmetler.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Musaitlik" asp-route-id="@Model.Id" class="btn btn-soft"><i class="bi bi-calendar-week me-1"></i> Müsaitlik</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-soft"><i class="bi bi-pencil me-1"></i> Düzenle</a>
        <button type="button" class="btn btn-soft text-danger"
                data-sil-url="@Url.Action("Delete", new { id = Model.Id })"
                data-sil-ad="@Model.AdSoyad"
                data-sil-uyari="@silUyari">
            <i class="bi bi-trash3 me-1"></i> Sil
        </button>
    </div>
</div>

<!-- ÜST BİLGİ KARTI -->
<div class="card-modern mb-4">
    <div class="d-flex flex-wrap gap-4 align-items-center p-4">
        <span class="avatar" style="width:72px;height:72px;border-radius:20px;font-size:26px;">@VeterinerHelper.BasHarfler(Model)</span>
        <div class="flex-grow-1 min-w-0">
            <h4 class="fw-bold mb-1">@Model.AdSoyad</h4>
            <div class="d-flex flex-wrap gap-3 mb-2">
                <div class="info-row"><i class="bi bi-envelope"></i>@Model.Kullanici?.Email</div>
                <div class="info-row">
                    <i class="bi bi-hospital"></i>
                    <a asp-controller="Klinik" asp-action="Details" asp-route-id="@Model.KlinikId">@Model.Klinik?.Ad</a>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-1">
                @foreach (var u in Model.UzmanlikAlanlari)
                {
                    <span class="chip blue">@u.Ad</span>
                }
            </div>
        </div>
    </div>
    <div class="detail-stats">
        <div><strong>@Model.Hizmetler.Count</strong><span>Verdiği hizmet</span></div>
        <div><strong>@VeterinerHelper.SureMetni(haftalik)</strong><span>Haftalık çalışma</span></div>
        <div><strong>@Model.Randevular.Count</strong><span>Toplam randevu</span></div>
    </div>
</div>

<div class="row g-4">
    <!-- HAFTALIK PROGRAM -->
    <div class="col-lg-6">
        <div class="card-modern h-100">
            <div class="card-modern-header">
                <span><i class="bi bi-calendar-week me-2 text-muted"></i>Haftalık Program</span>
                <a asp-action="Musaitlik" asp-route-id="@Model.Id" class="btn btn-sm btn-soft">Düzenle</a>
            </div>
            @foreach (var gun in GunHelper.HaftaSirasi)
            {
                var araliklar = Model.Musaitlikler.Where(m => m.Gun == gun).OrderBy(m => m.BaslangicSaati).ToList();
                <div class="list-row">
                    <div class="fw-semibold" style="width:110px;">
                        @GunHelper.TurkceAd(gun)
                        @if (gun == bugun)
                        {
                            <span class="chip ms-1" style="font-size:10px;padding:2px 6px;">Bugün</span>
                        }
                    </div>
                    <div class="d-flex flex-wrap gap-1">
                        @if (!araliklar.Any())
                        {
                            <span class="text-muted small">Çalışmıyor</span>
                        }
                        @foreach (var a in araliklar)
                        {
                            <span class="chip">@a.BaslangicSaati.ToString(@"hh\:mm") – @a.BitisSaati.ToString(@"hh\:mm")</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- HİZMETLER -->
    <div class="col-lg-6">
        <div class="card-modern h-100">
            <div class="card-modern-header">
                <span><i class="bi bi-clipboard2-pulse me-2 text-muted"></i>Verdiği Hizmetler</span>
            </div>
            @if (!Model.Hizmetler.Any())
            {
                <partial name="_AdminBosDurum" model='@(new BosDurumViewModel { Ikon = "bi-clipboard2-pulse", Baslik = "Hizmet yok", Aciklama = "Bu veterinere henüz hizmet atanmamış." })' />
            }
            else
            {
                @foreach (var h in Model.Hizmetler.OrderBy(h => h.Ad))
                {
                    <div class="list-row">
                        <div class="stat-icon tone-teal" style="width:38px;height:38px;font-size:16px;"><i class="bi @HizmetHelper.Ikon(h.Ad)"></i></div>
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-semibold">@h.Ad</div>
                            <small class="text-muted"><i class="bi bi-stopwatch me-1"></i>@HizmetHelper.SureMetni(h.SureDakika)</small>
                        </div>
                        <div class="fw-bold">@h.Ucret.ToString("N2") ₺</div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<partial name="_AdminSilModal" />

@section Scripts {
    <script src="~/js/admin-liste.js" asp-append-version="true"></script>
}