@model VeterinerKlinigi.Models.VeterinerFormViewModel
@{
    ViewData["Title"] = "Veteriner Düzenle";
    ViewData["ButonMetni"] = "Değişiklikleri Kaydet";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-head">
    <div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="back-link"><i class="bi bi-arrow-left"></i> Veteriner detayı</a>
        <h2>Veteriner Düzenle</h2>
        <p><strong>Vet. Hek. @Model.Ad @Model.Soyad</strong> bilgilerini güncelleyin.</p>
    </div>
    <a asp-action="Musaitlik" asp-route-id="@Model.Id" class="btn btn-soft"><i class="bi bi-calendar-week me-1"></i> Müsaitlik Saatleri</a>
</div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <partial name="_Form" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/veteriner-form.js" asp-append-version="true"></script>
}