@model VeterinerKlinigi.Entities.VeterinerHekim
@using System.Globalization
@using VeterinerKlinigi.Models
@{
    ViewData["Title"] = "Müsaitlik Saatleri";
    Layout = "~/Views/AdminLayout/Index.cshtml";

    var klinik = Model.Klinik!;
    var acilis = klinik.AcilisSaati;
    var kapanis = klinik.KapanisSaati;
    var toplamDakika = Math.Max(1, (kapanis - acilis).TotalMinutes);
    var orta = TimeSpan.FromHours(Math.Round((acilis + kapanis).TotalHours / 2));
    var bugun = DateTime.Today.DayOfWeek;

    // CSS'te yüzde değerleri nokta ile yazılmalı (Türkçe virgül CSS'i bozar)
    string Yuzde(double deger) => deger.ToString("0.##", CultureInfo.InvariantCulture) + "%";
}

<div class="page-head">
    <div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="back-link"><i class="bi bi-arrow-left"></i> Veteriner detayı</a>
        <h2>Müsaitlik Saatleri</h2>
        <p>
            <strong>@Model.AdSoyad</strong> · @klinik.Ad
            <span class="chip gray ms-1"><i class="bi bi-clock"></i>Klinik: @acilis.ToString(@"hh\:mm") – @kapanis.ToString(@"hh\:mm")</span>
        </p>
    </div>
    <div class="text-end">
        <div class="price-tag">@VeterinerHelper.SureMetni(VeterinerHelper.HaftalikSure(Model))</div>
        <small class="text-muted">Haftalık toplam çalışma</small>
    </div>
</div>

<div class="row g-4">
    <!-- EKLEME FORMU -->
    <div class="col-xl-4">
        <div class="card-modern preview-sticky">
            <div class="card-modern-header"><span><i class="bi bi-plus-circle me-2 text-muted"></i>Müsaitlik Ekle</span></div>
            <form asp-action="MusaitlikEkle" method="post" id="musaitlikForm">
                <input type="hidden" name="veterinerHekimId" value="@Model.Id" />
                <div class="card-modern-body">
                    <!-- Günler -->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label mb-0">Günler</label>
                        <div class="d-flex gap-1">
                            <button type="button" class="quick-chip" data-gun-sec="haftaici">Hafta içi</button>
                            <button type="button" class="quick-chip" data-gun-sec="hepsi">Tümü</button>
                            <button type="button" class="quick-chip" data-gun-sec="temizle">Temizle</button>
                        </div>
                    </div>
                    <div class="select-grid" style="grid-template-columns: repeat(4, 1fr);">
                        @foreach (var gun in GunHelper.HaftaSirasi)
                        {
                            <label class="select-card compact">
                                <input type="checkbox" name="gunler" value="@((int)gun)" />
                                <span class="sc-body">@GunHelper.KisaAd(gun)</span>
                            </label>
                        }
                    </div>
                    <div id="gunUyari" class="small text-danger mt-2 d-none"><i class="bi bi-exclamation-circle me-1"></i>En az bir gün seçmelisiniz.</div>

                    <!-- Saatler -->
                    <div class="row g-2 mt-3">
                        <div class="col-6">
                            <label class="form-label">Başlangıç</label>
                            <input type="time" name="baslangicSaati" id="baslangicSaati" class="form-control" value="@acilis.ToString(@"hh\:mm")" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Bitiş</label>
                            <input type="time" name="bitisSaati" id="bitisSaati" class="form-control" value="@kapanis.ToString(@"hh\:mm")" required />
                        </div>
                    </div>
                    <div class="quick-chips">
                        <button type="button" class="quick-chip" data-aralik="@acilis.ToString(@"hh\:mm")-@kapanis.ToString(@"hh\:mm")">Tam gün</button>
                        <button type="button" class="quick-chip" data-aralik="@acilis.ToString(@"hh\:mm")-@orta.ToString(@"hh\:mm")">Sabah</button>
                        <button type="button" class="quick-chip" data-aralik="@orta.ToString(@"hh\:mm")-@kapanis.ToString(@"hh\:mm")">Öğleden sonra</button>
                    </div>
                    <div class="small text-muted mt-3"><i class="bi bi-info-circle me-1"></i>Saatler kliniğin çalışma saatleri içinde olmalı ve aynı gündeki diğer aralıklarla çakışmamalıdır.</div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-brand w-100"><i class="bi bi-plus-lg me-1"></i> Seçilen Günlere Ekle</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ZAMAN ÇİZELGESİ -->
    <div class="col-xl-8">
        <div class="card-modern">
            <div class="card-modern-header">
                <span><i class="bi bi-calendar-week me-2 text-muted"></i>Haftalık Çalışma Programı</span>
                <span class="small text-muted fw-normal">Silmek için aralığın üzerindeki <i class="bi bi-x"></i> butonunu kullanın</span>
            </div>

            <div class="timeline-scale">
                <span>@acilis.ToString(@"hh\:mm")</span>
                <span>@orta.ToString(@"hh\:mm")</span>
                <span>@kapanis.ToString(@"hh\:mm")</span>
            </div>

            @foreach (var gun in GunHelper.HaftaSirasi)
            {
                var araliklar = Model.Musaitlikler.Where(m => m.Gun == gun).OrderBy(m => m.BaslangicSaati).ToList();
                var gunlukToplam = TimeSpan.FromMinutes(araliklar.Sum(a => (a.BitisSaati - a.BaslangicSaati).TotalMinutes));

                <div class="timeline-row">
                    <div class="timeline-day">
                        @GunHelper.TurkceAd(gun)
                        @if (gun == bugun)
                        {
                            <span class="chip ms-1" style="font-size:10px;padding:2px 6px;">Bugün</span>
                        }
                    </div>
                    <div class="timeline-track">
                        @foreach (var a in araliklar)
                        {
                            var sol = (a.BaslangicSaati - acilis).TotalMinutes / toplamDakika * 100;
                            var genislik = (a.BitisSaati - a.BaslangicSaati).TotalMinutes / toplamDakika * 100;

                            <div class="timeline-bar" style="left:@Yuzde(sol);width:@Yuzde(genislik);"
                                 title="@a.BaslangicSaati.ToString(@"hh\:mm") – @a.BitisSaati.ToString(@"hh\:mm")">
                                <span class="text-truncate">@a.BaslangicSaati.ToString(@"hh\:mm")–@a.BitisSaati.ToString(@"hh\:mm")</span>
                                <form asp-action="MusaitlikSil" method="post" class="m-0">
                                    <input type="hidden" name="id" value="@a.Id" />
                                    <input type="hidden" name="veterinerId" value="@Model.Id" />
                                    <button type="submit" title="Bu aralığı sil"><i class="bi bi-x-lg"></i></button>
                                </form>
                            </div>
                        }
                    </div>
                    <div class="timeline-total">
                        @(araliklar.Any() ? VeterinerHelper.SureMetni(gunlukToplam) : "—")
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/musaitlik.js" asp-append-version="true"></script>
}